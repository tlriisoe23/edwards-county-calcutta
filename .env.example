# Comma-separated owner emails. Set the hosted value through Sites settings.
ADMIN_EMAILS=

# The leaderboard this Calcutta reads its flighted field from (WC-6). In the
# deployed stack it is a host on a private, internal-only Docker network, so the
# request never leaves the machine. Leave it unset and the import falls back to
# pasting rows, which is the point of having both.
LEADERBOARD_URL=http://leaderboard:3000
